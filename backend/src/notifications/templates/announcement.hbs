<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f4f6f8; margin: 0; padding: 20px; }
    .card { background: #ffffff; border-radius: 8px; padding: 24px; max-width: 600px; margin: 0 auto; border: 1px solid #e1e4e8; }
    h2 { color: #2c5282; }
    p { color: #4a5568; line-height: 1.6; }
    .message-box { background: #ebf8ff; border-left: 4px solid #3182ce; padding: 12px 16px; margin: 16px 0; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>📢 Announcement: {{title}}</h2>
    <p>Hello {{recipientName}},</p>
    <p>An announcement was posted for <strong>{{eventName}}</strong>:</p>
    <div class="message-box">{{message}}</div>
  </div>
</body>
</html>
